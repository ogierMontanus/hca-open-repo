~*
~$*

__pycache__/
*.pyc

# Built mockup data — regenerated by scripts/build_web/build_web_data.py
web/data/

# Local-only generated diary pages — too many to commit (4500+ files)
mockup/diary-pages/

# Local-only generated diary index data (~2 MB) — regenerate with
# scripts/build_mockup/build_diary_index.py. Pages degrade gracefully
# to their curated sample cards when these are absent.
mockup/data/diary-index.js
mockup/data/diary-refs.js
mockup/data/timeline-index.js

# Local-only generated per-entity card data — regenerate with the
# build_*_extra.py scripts. work.html / person.html / place.html fall
# back to their curated WORKS / PERSONS / PLACES dicts (and a sensible
# default Reg) when these are absent.
mockup/data/works-extra.js
mockup/data/persons-extra.js
mockup/data/places-extra.js

# Local-only co-occurrence index (~770 KB) — regenerate with
# scripts/build_mockup/build_cooccurrence.py. The "Hyppigste steder /
# personer" sections on person.html and place.html hide silently when
# this file is absent.
mockup/data/cooccurrence.js

# Local-only nation index — regenerate with
# scripts/build_mockup/build_nation_index.py. nation.html shows a
# "data not built yet" message when this file is absent.
mockup/data/nation-index.js

